---
interface Props {
  label: string;
  variant?: 'default' | 'gold' | 'outline';
}

const { label, variant = 'default' } = Astro.props;

const styles = {
  default: 'bg-navy/10 text-navy border border-navy/20 hover:border-gold hover:text-gold',
  gold: 'bg-gold/10 text-gold border border-gold/30',
  outline: 'border border-white/30 text-white/70 hover:border-gold hover:text-gold',
};
---

<span class={`inline-block px-3 py-1 text-xs tracking-wide rounded-sm transition-colors ${styles[variant]}`}>
  {label}
</span>
