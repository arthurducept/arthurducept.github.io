---
interface Props {
  title: string;
  dark?: boolean;
}

const { title, dark = false } = Astro.props;
---

<div class="mb-16">
  <h2 class={`text-3xl md:text-4xl font-bold tracking-tight ${dark ? 'text-white' : 'text-navy'}`}>
    {title}
  </h2>
  <div class={`mt-3 h-0.5 w-16 ${dark ? 'bg-gold' : 'bg-gold'}`}></div>
</div>
