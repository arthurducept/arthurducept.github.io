---
import Button from "../ui/Button.astro";
import type { Translation } from "../../i18n/types";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = lang === "fr" ? "/fr" : "";
---

<section class="min-h-screen bg-navy flex flex-col relative overflow-hidden">
  <!-- Logo icon watermark — full-bleed, barely visible -->
  <div
    class="absolute inset-0 flex items-center justify-start pointer-events-none"
    aria-hidden="true"
  >
    <img
      src="/images/logo/logo-icon-white.svg"
      alt=""
      class="w-[90vh] max-w-none opacity-[0.04] -translate-x-1/4"
    />
  </div>

  <div
    class="relative flex-1 flex items-center max-w-6xl mx-auto w-full px-6 pt-24 pb-20"
  >
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16 w-full">
      <!-- Text content -->
      <div class="flex-1 min-w-0">
        <p
          class="text-white/60 text-sm tracking-[0.3em] uppercase mb-6 font-thin"
        >
          {t.hero.available}
        </p>

        <h1
          class="text-5xl md:text-7xl font-bold text-white leading-tight mb-4"
        >
          {t.hero.title}
        </h1>

        <p class="text-2xl md:text-3xl font-bold text-gold mb-12 tracking-wide">
          {t.hero.subtitle}
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href={`${base}/#contact`} variant="primary">
            {t.hero.ctaContact}
          </Button>
          <Button href="/cv/Arthur_Ducept_CV.pdf" variant="ghost">
            {t.hero.ctaCV}
          </Button>
        </div>
      </div>

      <!-- Photo -->
      <div class="flex-shrink-0 hidden md:block">
        <div class="relative w-72 h-72 lg:w-80 lg:h-80">

          <!-- Dotted grid accent (top-left) -->
          <div class="absolute -top-6 -left-6 grid grid-cols-6 gap-1.5 opacity-50" aria-hidden="true">
            {Array.from({ length: 36 }).map(() => (
              <span class="w-1 h-1 bg-gold rounded-full"></span>
            ))}
          </div>

          <!-- Offset gold frame (with matching corner cut) -->
          <div
            class="absolute inset-0 border-2 border-gold/50 translate-x-4 translate-y-4"
            style="clip-path: polygon(0 0, calc(100% - 32px) 0, 100% 32px, 100% 100%, 0 100%);"
            aria-hidden="true"
          ></div>

          <!-- Photo with cut top-right corner -->
          <div
            class="relative w-full h-full overflow-hidden"
            style="clip-path: polygon(0 0, calc(100% - 32px) 0, 100% 32px, 100% 100%, 0 100%);"
          >
            <img
              src="/images/photo.png"
              alt="Arthur Ducept"
              class="w-full h-full object-cover"
              style="object-position: center 15%; transform: scale(1.4); transform-origin: center 90%;"
              loading="eager"
            />
          </div>

          <!-- Gold line accent (bottom-left) -->
          <div class="absolute -bottom-3 -left-3 h-0.5 w-20 bg-gold" aria-hidden="true"></div>
          <div class="absolute -bottom-3 -left-3 w-0.5 h-10 bg-gold" aria-hidden="true"></div>

          <!-- Diagonal line in cut corner (top-right) -->
          <div
            class="absolute top-0 right-0 w-12 h-0.5 bg-gold origin-right"
            style="transform: rotate(-45deg) translateX(2px);"
            aria-hidden="true"
          ></div>
        </div>
      </div>
      <!-- /Photo -->
    </div>
  </div>

  <div class="relative flex justify-center pb-10 hidden md:flex">
    <div class="flex flex-col items-center gap-2 text-white/30 animate-bounce">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>
  </div>
</section>
