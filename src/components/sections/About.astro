---
import SectionTitle from '../ui/SectionTitle.astro';
import ReadMoreLink from '../ui/ReadMoreLink.astro';
import type { Translation } from '../../i18n/types';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  t: Translation;
}

const { lang, t } = Astro.props;
const base = lang === 'fr' ? '/fr' : '';
---

<section id="about" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <SectionTitle title={t.about.sectionTitle} />

    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div>
        <p class="text-lg text-gray-700 leading-relaxed font-thin mb-8">
          {t.about.bio}
        </p>

        <div class="flex items-center gap-2 text-sm text-navy/70 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {t.about.location}
        </div>

        <div class="inline-flex items-center gap-2 bg-gold/10 border border-gold/30 text-gold px-4 py-2 text-sm">
          <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
          {t.about.availability}
        </div>
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="text-xs tracking-[0.2em] uppercase text-navy/50 mb-4">{t.about.languagesTitle}</h3>
          <div class="space-y-3">
            {t.about.languages.map((lang) => (
              <div class="flex items-center justify-between border-b border-gray-light pb-3">
                <span class="font-bold text-navy">{lang.label}</span>
                <span class="text-sm text-navy/60 font-thin">{lang.level}</span>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-xs tracking-[0.2em] uppercase text-navy/50 mb-4">Stack</h3>
          <div class="flex flex-wrap gap-2">
            {['TypeScript', 'React', 'Vue 3', 'NestJS', 'PostgreSQL', 'AWS'].map((tech) => (
              <span class="bg-navy text-white text-xs px-3 py-1.5 tracking-wide">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12">
      <ReadMoreLink href={`${base}/about`} label={t.common.readMore} />
    </div>
  </div>
</section>
