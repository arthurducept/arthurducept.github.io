---
import { getCollection } from 'astro:content';
import SectionTitle from '../ui/SectionTitle.astro';
import Tag from '../ui/Tag.astro';
import type { Translation } from '../../i18n/types';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  t: Translation;
}

const { lang, t } = Astro.props;
const p = t.pages.projects;

const all = await getCollection('projects', ({ data }) => data.lang === lang);
const sorted = all.sort((a, b) => a.data.order - b.data.order);

const base = lang === 'fr' ? '/fr' : '';
---

<section class="pt-32 pb-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20">
      <SectionTitle title={p.title} />
      <p class="text-base text-gray-700 font-thin max-w-2xl mx-auto mt-4">{p.subtitle}</p>
    </div>

    <div class="space-y-6">
      {sorted.map((entry, idx) => {
        const d = entry.data;
        const href = `${base}/projects/${d.urlSlug}`;
        return (
          <a
            href={href}
            class="group block bg-white border border-gray-light hover:border-gold/50 transition-all duration-300 hover:-translate-y-1"
          >
            <div class="grid md:grid-cols-[1fr_auto] gap-6 p-8">
              <div class="min-w-0">
                <div class="flex items-start gap-3 mb-2">
                  <span class="text-xs tracking-widest uppercase text-navy/40 font-bold">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  {d.tag && (
                    <span class="text-xs tracking-widest uppercase text-gold border border-gold/30 px-2 py-0.5">
                      {d.tag}
                    </span>
                  )}
                </div>

                <h2 class="text-2xl md:text-3xl font-bold text-navy leading-tight mb-2 group-hover:text-gold transition-colors">
                  {d.title}
                </h2>

                <p class="text-sm text-navy/50 font-thin mb-4">
                  {d.client}{d.period ? ` · ${d.period}` : ''}
                </p>

                <p class="text-base text-gray-700 font-thin leading-relaxed mb-5">
                  {d.description}
                </p>

                <div class="flex flex-wrap gap-2">
                  {d.tech.map((tech) => (
                    <Tag label={tech} />
                  ))}
                </div>
              </div>

              <div class="md:w-48 flex flex-row md:flex-col md:items-end gap-4 md:gap-2 md:border-l md:pl-6 md:border-gray-light md:justify-center">
                {d.metrics.length > 0 && (
                  <div class="flex flex-col gap-1 md:items-end">
                    {d.metrics.map((m) => (
                      <span class="text-sm font-bold text-gold md:text-right">{m}</span>
                    ))}
                  </div>
                )}
                <span class="self-end md:self-end text-xs tracking-widest uppercase text-navy/60 group-hover:text-gold transition-colors mt-auto flex items-center gap-1">
                  {t.common.viewProject} →
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
