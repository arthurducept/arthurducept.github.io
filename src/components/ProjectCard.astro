---
import Tag from './ui/Tag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, client, description, tech, metrics, tag } = entry.data;
---

<div class="bg-white border border-gray-light hover:border-gold/50 transition-all duration-300 hover:-translate-y-1 flex flex-col">
  <div class="p-6 flex-1">
    <div class="flex items-start justify-between gap-3 mb-2">
      <h3 class="font-bold text-navy text-lg leading-tight">{title}</h3>
      {tag && (
        <span class="text-xs tracking-widest uppercase text-gold border border-gold/30 px-2 py-0.5 flex-shrink-0">
          {tag}
        </span>
      )}
    </div>
    <p class="text-sm text-navy/50 font-thin mb-4">{client}</p>
    <p class="text-sm text-gray-700 font-thin leading-relaxed mb-6">{description}</p>

    <div class="flex flex-wrap gap-2 mb-6">
      {tech.map((t) => (
        <Tag label={t} />
      ))}
    </div>
  </div>

  {metrics.length > 0 && (
    <div class="border-t border-gray-light bg-navy/3 p-4 flex flex-wrap gap-4">
      {metrics.map((metric) => (
        <span class="text-sm font-bold text-gold">{metric}</span>
      ))}
    </div>
  )}
</div>
